{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "easyapply-backend",
  "main": "src/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "easyapply-db",
      "database_id": "072d40aa-7097-4dc7-a026-dbdaae476179"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RESUME_BUCKET",
      "bucket_name": "easyapply-resumes"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION_KV",
      "id": "8f9a012fe1da4ff083bf8175cf541ac4"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "NODE_ENV": "production",
    "CALLS_APP_ID": "02592ddefba24b423a23a6aa9796f716",
    "CALLS_APP_TOKEN": "a8515980194cacf12eafdbaa71f0eb2d7900b237ae2bab8e8f126bd2a1b66623",
    "CLOUDFLARE_TURN_KEY_ID": "5ad429cf3aa3178d86b8cf96061bab1f"
  }
}
